      "item": [
        {
          "id": "b1a1e001-0000-4000-8000-000000000010",
          "name": "List projects",
          "request": {
            "name": "List projects",
            "description": {
              "content": "GraphQL query listing projects for the authenticated owner.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "graphql"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query ListProjects($limit: Int) { projects(limit: $limit) { edges { node { _id name region { id name } } } pageInfo { hasNextPage endCursor } } }\",\n  \"variables\": { \"limit\": 20 }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "id": "b1a1e001-0000-4000-8000-000000000011",
          "name": "Create project",
          "request": {
            "name": "Create project",
            "description": {
              "content": "GraphQL mutation creating a project in a region.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "graphql"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation CreateProject($region: String!, $name: String!) { createProject(region: $region, name: $name) { _id name } }\",\n  \"variables\": { \"region\": \"sfo1\", \"name\": \"my-project\" }\n}",
              "options": {
                "raw": {
                  "language": "json"
