              "mode": "raw",
              "raw": "{\n  \"query\": \"query Deployments($serviceID: ObjectID!, $environmentID: ObjectID!) { deployments(serviceID: $serviceID, environmentID: $environmentID) { edges { node { _id status createdAt } } } }\",\n  \"variables\": { \"serviceID\": \"<SERVICE_ID>\", \"environmentID\": \"<ENV_ID>\" }\n}",
              "options": {
